From 1e00eb736e733fa29aa899680314ab64b867258b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 20 Aug 2026 23:54:46 +0000
Subject: [PATCH 23/52] M4.8: mirror Clear into the colour and depth twins

A twin that is never cleared holds last frame's contents, and the second eye
would be composited over that garbage. This lands BEFORE anything renders into
a twin on purpose: a missing clear looks exactly like a rendering bug, and
would send the next step chasing the wrong thing.

Level-0 surfaces are captured at twin creation rather than per draw, so the
lookup is a pointer compare instead of a COM call on every draw. Re-entry
guarded, since the mirrored clear goes through this same function.
---
 src/d3d9/d3d9_device.cpp | 41 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/src/d3d9/d3d9_device.cpp b/src/d3d9/d3d9_device.cpp
index a8c49bf9..ccd1b1b7 100644
--- a/src/d3d9/d3d9_device.cpp
+++ b/src/d3d9/d3d9_device.cpp
@@ -180,6 +180,11 @@ namespace dxvk {
   static uint32_t vrDepthN     = 0;
   // Look up the right-eye counterpart of whatever is currently bound. Returns
   // null when there is no twin, which is the signal to leave a draw alone.
+  static IDirect3DSurface9* VrTwinOfColour(IDirect3DSurface9* left) {
+    for (uint32_t i = 0; i < vrTwinN; i++)
+      if (vrTwins[i].left == left) return vrTwins[i].right;
+    return nullptr;
+  }
   static IDirect3DSurface9* VrTwinOfDepth(IDirect3DSurface9* left) {
     for (uint32_t i = 0; i < vrDepthN; i++)
       if (vrDepths[i].left == left) return vrDepths[i].right;
@@ -1051,6 +1056,10 @@ namespace dxvk {
           uint64_t bytes = (uint64_t)Width * Height * bpp;
           vrTwins[vrTwinN].leftTex  = *ppTexture;
           vrTwins[vrTwinN].rightTex = twin;
+          // Grab level 0 of each now. Doing it per draw would mean a COM call
+          // and a release on every single draw of every frame.
+          (*ppTexture)->GetSurfaceLevel(0, &vrTwins[vrTwinN].left);
+          twin->GetSurfaceLevel(0, &vrTwins[vrTwinN].right);
           vrTwins[vrTwinN].w = Width; vrTwins[vrTwinN].h = Height;
           vrTwins[vrTwinN].fmt = Format;
           vrTwinN++;
@@ -2395,6 +2404,38 @@ namespace dxvk {
       return D3D_OK;
 
     D3D9DeviceLock lock = LockDevice();
+
+    // M4.8: CLEAR THE TWINS TOO.
+    // A twin that is never cleared is a buffer full of last frame's contents,
+    // and the second eye would be composited over that garbage. This has to
+    // land before anything renders into a twin, because a missing clear looks
+    // like a rendering bug and would send the next step chasing the wrong
+    // thing entirely.
+    // Re-entry guarded: the duplicate clear goes through this same function.
+    static bool vrClearing = false;
+    if (dxvk_vr_twin && !vrClearing && (vrTwinN || vrDepthN)) {
+      IDirect3DSurface9* curRt = m_state.renderTargets[0].ptr();
+      IDirect3DSurface9* curDs = m_state.depthStencil.ptr();
+      IDirect3DSurface9* twRt  = VrTwinOfColour(curRt);
+      IDirect3DSurface9* twDs  = VrTwinOfDepth(curDs);
+      if (twRt != nullptr || twDs != nullptr) {
+        vrClearing = true;
+        Com<IDirect3DSurface9> saveRt = curRt;
+        Com<IDirect3DSurface9> saveDs = curDs;
+        if (twRt != nullptr) SetRenderTargetInternal(0, twRt);
+        if (twDs != nullptr) SetDepthStencilSurface(twDs);
+        Clear(Count, pRects, Flags, Color, Z, Stencil);
+        if (twRt != nullptr) SetRenderTargetInternal(0, saveRt.ptr());
+        if (twDs != nullptr) SetDepthStencilSurface(saveDs.ptr());
+        vrClearing = false;
+        static uint32_t vrClearsTold = 0;
+        if (vrClearsTold < 3) { vrClearsTold++;
+          Logger::info(str::format("VR twin clear mirrored (flags=", Flags,
+            ", colour twin=", twRt != nullptr ? 1 : 0,
+            ", depth twin=", twDs != nullptr ? 1 : 0, ")")); }
+      }
+    }
+
     BindFramebuffer();
 
     // D3DCLEAR_ZBUFFER and D3DCLEAR_STENCIL are invalid flags
-- 
2.43.0

